+static int bw_queue_adaptive(void)
+{
+    if (s_bq_mode < 0) {
+        const char *e = getenv("BW_APU_QUEUE");
+        s_bq_mode = !(e && e[0] == 'f');
+    }
+    return s_bq_mode;
