+    if (s_bq_mode <= 0 || !s_bq_step)
+        return;
+    if (!s_bq_start) {
+        s_bq_start = now_us;
+        s_bq_calm_since = now_us;
+        s_bq_last_u = u;
+        return;
+    }
+    if (u != s_bq_last_u) {
+        s_bq_last_u = u;
+        s_bq_calm_since = now_us;
