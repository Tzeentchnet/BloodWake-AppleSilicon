+        if (f) {
+            uint8_t h[44] = { 0 };
+            fwrite(h, 1, 44, f);
+        }
+    }
+    if (!f)
+        return;
+    fwrite(s, 12, (size_t)n, f);
+    frames += (uint32_t)n;
+    if (frames % 48000 < (uint32_t)n) {
+        uint8_t h[44];
+        uint32_t data = frames * 12, riff = 36 + data, sr = 48000, br = 48000 * 12, fl = 16;
+        uint16_t pcm = 1, ch = 6, ba = 12, bps = 16;
