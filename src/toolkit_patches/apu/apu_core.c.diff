+    }
+    if (h != high) {
+        d->monitor.queued_bytes_high = h * SAMPLE_BYTES;
+        d->monitor.queued_bytes_low = h / 2 * SAMPLE_BYTES;
+        if (s_bq_logged++ < 40)
+            fprintf(stderr, "[APU] BW device queue %s to %d samples (%.1f ms; underruns %u)\n",
+                    h > high ? "raised" : "lowered", h, h / 48.0, u);
+    }
+}
