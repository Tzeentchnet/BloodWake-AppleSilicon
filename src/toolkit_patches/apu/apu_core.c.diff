+                     MIXER_FRAME_SAMPLES, &l, &s_bq_base);
+    xa2_pacing_marks(buf_samples, count < 4 ? count : 4, MIXER_FRAME_SAMPLES, &l, &h);
+    if (h < s_bq_base)
+        h = s_bq_base;
+    s_bq_step = buf_samples;
+    s_bq_cap = buf_samples * (count - 1);
