@@ -513,6 +519,18 @@
 {
     if (addr >= g_xbox_image_lo && addr < g_xbox_image_hi)
         return addr;
+    /* Blood Wake carried patch (docs/TOOLKIT_ISSUES.md TK-13, D-010).
+     *
+     * A heap page the title named through MmGetPhysicalAddress is RAM, even
+     * where the contiguous allocator has handed out the same number as a
+     * window page -- the rule the APU already follows (apu_core.c). XAPI's
+     * XID driver gives the controller a heap buffer for the pad's input
+     * report; once the arena's high-water mark passed it, every report went
+     * to the window copy (0x814430CA in run 20261025-234225-r4-input, START
+     * seen there) while the driver read the heap one, and no button ever
+     * reached the title. */
+    if (addr && addr < (64u << 20) && xbox_PhysRamNameMap()[addr >> 12])
+        return addr;
     if (addr && addr < xbox_ContiguousAllocatedBytes())
         return OHCI_CONTIG_BASE + addr;
     return addr;
