+                int immediate = pending[0] == '!';
+                char *body = pending + immediate;
+                int pd = (body[0] == 'p' || body[0] == 'P')
+                         && body[1] >= '1' && body[1] <= '4'
+                         && body[2] == '-' ? body[1] - '1' : 0;
+                unsigned long at = immediate ? t : (t > next_free[pd] ? t : next_free[pd]);
                 pending[npending] = 0;
-                snprintf(line, sizeof line, "%lu:%s", at, pending);
+                if (immediate) {
+                    /* A new decision ends this pad's immediate steps from
