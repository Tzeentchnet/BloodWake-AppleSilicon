+                            && s_script[k].at_ms < t
+                            && s_script[k].at_ms + s_script[k].hold_ms > t)
+                            s_script[k].hold_ms = t - s_script[k].at_ms;
+                    if (body[0] == '!') {
+                        npending = 0;
+                        continue;
+                    }
+                }
+                snprintf(line, sizeof line, "%lu:%s", at, body);
                 if (s_script_len >= PAD_SCRIPT_MAX - 1)
                     pad_script_compact(t);
                 pad_script_parse(line);
-                if (s_script_len > 0)
+                if (s_script_len > 0 && !immediate)
                     next_free[pd] = at + s_script[s_script_len - 1].hold_ms + 200;
+                if (s_script_len > 0 && immediate)
+                    s_script[s_script_len - 1].immediate = 1;
                 fprintf(stderr, "  PAD: live \"%s\" at t=%lu ms\n", pending, at);
                 fflush(stderr);
                 npending = 0;
