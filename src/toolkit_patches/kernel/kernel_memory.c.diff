--- xboxrecomp/src/kernel/kernel_memory.c
+++ src/toolkit_patches/kernel/kernel_memory.c
@@ -164,6 +164,41 @@
         VirtualFree(BaseAddress, 0, MEM_RELEASE);
 }
 
+/* Blood Wake carried patch (TK-17, docs/TOOLKIT_ISSUES.md): which copy the
+ * title meant when it last translated each physical page below 64 MB:
+ * 1 = RAM (a heap or image address), 2 = the contiguous window. A device
+ * model that is handed the number right after the translation (DirectSound
+ * posting a buffer page or a stream segment to the APU) can then tell the two
+ * copies apart where the heap and the window share a number.
+ * BW_PHYS_TRACE=<lo>,<hi> (hex physical) prints the first 80 translations in
+ * that range. The original file is xboxrecomp/src/kernel/kernel_memory.c
+ * (sha256 guarded in CMakeLists.txt). */
+#include <stdio.h>
+#include <stdlib.h>
+static volatile uint8_t g_bw_phys_last[(64u << 20) / 4096];
+
+const volatile uint8_t *bw_PhysLastTranslationMap(void)
+{
+    return g_bw_phys_last;
+}
+
+static void bw_note_translation(uint32_t phys, uint8_t kind, uint32_t va)
+{
+    static int trace = -1;
+    static uint32_t lo, hi;
+    static volatile LONG shown;
+    if (phys >= (64u << 20))
+        return;
+    g_bw_phys_last[phys >> 12] = kind;
+    if (trace < 0) {
+        const char *e = getenv("BW_PHYS_TRACE");
+        trace = e && sscanf(e, "%x,%x", &lo, &hi) == 2;
+    }
+    if (trace && phys >= lo && phys < hi && InterlockedIncrement(&shown) <= 80)
+        fprintf(stderr, "[PHYS] MmGetPhysicalAddress(%08X) -> %08X (%s)\n",
+                va, phys, kind == 2 ? "window" : "RAM");
+}
+
 ULONG_PTR __stdcall xbox_MmGetPhysicalAddress(PVOID BaseAddress)
 {
     /*
@@ -181,11 +216,14 @@
      */
     uint32_t va = (uint32_t)(uintptr_t)BaseAddress;
     if (va >= XBOX_CONTIG_BASE &&
-            (uint64_t)va < (uint64_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE)
+            (uint64_t)va < (uint64_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE) {
+        bw_note_translation(va - XBOX_CONTIG_BASE, 2, va);     /* TK-17 */
         return (ULONG_PTR)(va - XBOX_CONTIG_BASE);
+    }
     /* The same number can be a window page; record that the title meant RAM
      * (xbox_PhysNoteRamName says why the APU needs to know). */
     xbox_PhysNoteRamName(va);
+    bw_note_translation(va, 1, va);                             /* TK-17 */
     return (ULONG_PTR)va;
 }
 
