+static uint64_t s_bw_begins, s_bw_ends, s_bw_nops_tagged;
+/* Blood Wake (first segment): methods executed after the first segment. */
+static uint8_t s_bw_after[8][0x800];
+static void bw_pb_exec(uint32_t subch, uint32_t m, uint32_t param)
+{
+    s_bw_after[subch & 7][(m & 0x1FFCu) >> 2] = 1;
+    if (m == 0x17FC) {
+        if (param) s_bw_begins++; else s_bw_ends++;
+    } else if (m == 0x0100 && (param >> 16) == 0xB1D3u) {
+        s_bw_nops_tagged++;
+    }
+    nv2a_pb_exec_method(subch, m, param);
+}
